# SOPS encrypted WireGuard private key
# To encrypt: sops --encrypt --age <recipient> --in-place wireguard.yaml
#
# After creating this file with your plaintext key, run:
#   sops --encrypt --age <recipient-age-key> --in-place hosts/legend/secrets/wireguard.yaml
#
# The file should contain:
# wg0_private_key: "YOUR_PRIVATE_KEY_HERE"
wg0_private_key: REPLACE_WITH_ACTUAL_PRIVATE_KEY_THEN_ENCRYPT
